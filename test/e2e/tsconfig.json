{
  "compilerOptions": {
    "target": "ES2023",
    // DOM 只为 page.evaluate 里那几段在浏览器里跑的代码：它们是页面上下文，
    // 用 Node 的类型描述它们只会把 document 说成不存在。
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["harness", "specs", "playwright.config.ts"]
}
